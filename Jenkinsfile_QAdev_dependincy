// assignment

def devstage=''
pipeline{
    agent any

stages{

      stage('DEV'){
            steps{
            script{
            try{

                  sh'''
                  pwd
                  exit 1
                  '''
                  devstage='SUCCESS'
                  
            }catch(Exception e){
                  echo "ciaught an exception in dev stage"
                  echo "${e.message}"
                  devstage='FAILURE'
                  }
            }
            }
      }
            stage('TEST'){
                  when{
                        expression{

                              devstage=='SUCCESS'
                        }
                  }
                  steps{

                        sh 'ls -lrt'
                        sleep 10
                  }
            }
             stage('DEploy'){
                  when{
                        expression{

                              devstage=='FAILURE'
                        }
                  }
                  steps{

                        sh 'll'
                        sh 'pwd'
                        sleep 10
                  }
            }
      }


}